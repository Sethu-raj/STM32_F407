int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_USART2_UART_Init();

  DWT_Delay_Init();

  char msg[100];

  UART_Print("\r\nSystem boot\r\n");

  uint32_t jedec = W25_ReadJEDECID();
  snprintf(msg, sizeof(msg), "W25Q JEDEC ID = 0x%06lX\r\n", (unsigned long)jedec);
  UART_Print(msg);

  /* Check already saved values after reset */
  uint32_t slot = 0;
  for (uint32_t i = 0; i < HISTORY_COUNT; i++)
  {
    uint32_t v = W25_ReadWord(FLASH_BASE_ADDR + (i * 4U));
    if (v != 0xFFFFFFFFU)
    {
      slot = i + 1;
    }
    else
    {
      break;
    }
  }

  if (slot > 0)
  {
    UART_Print("Found previous data in flash\r\n");
    PrintSavedHistory();
  }
  else
  {
    UART_Print("Flash is empty\r\n");
  }

  while (1)
  {
    if (slot >= HISTORY_COUNT)
    {
      UART_Print("\r\nFlash history full. Showing data and erasing sector...\r\n");
      PrintSavedHistory();
      W25_EraseSector(FLASH_BASE_ADDR);
      slot = 0;
      UART_Print("Sector erased\r\n");
    }

    int32_t dist = Ultrasonic_ReadCm();
    if (dist >= 0)
    {
      snprintf(msg, sizeof(msg), "Distance = %ld cm\r\n", (long)dist);
      UART_Print(msg);

      W25_WriteWord(FLASH_BASE_ADDR + (slot * 4U), (uint32_t)dist);

      snprintf(msg, sizeof(msg), "Saved to flash slot %lu\r\n", (unsigned long)slot);
      UART_Print(msg);

      slot++;
    }
    else
    {
      UART_Print("Ultrasonic timeout\r\n");
    }

    HAL_Delay(1000);
  }
}

