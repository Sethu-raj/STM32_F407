static uint32_t dwt_cycles_per_us = 0;

static void UART_Print(const char *msg)
{
  HAL_UART_Transmit(&huart2, (uint8_t *)msg, strlen(msg), HAL_MAX_DELAY);
}

static void DWT_Delay_Init(void)
{
  CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
  DWT->CYCCNT = 0;
  DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
  dwt_cycles_per_us = SystemCoreClock / 1000000U;
}

static void delay_us(uint32_t us)
{
  uint32_t start = DWT->CYCCNT;
  uint32_t ticks = us * dwt_cycles_per_us;
  while ((DWT->CYCCNT - start) < ticks)
  {
  }
}

static uint8_t W25_ReadStatus1(void)
{
  uint8_t tx[2] = {W25Q_READ_STATUS1, 0xFF};
  uint8_t rx[2] = {0};

  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_RESET);
  HAL_SPI_TransmitReceive(&hspi1, tx, rx, 2, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_SET);

  return rx[1];
}

static void W25_WaitBusy(void)
{
  while (W25_ReadStatus1() & 0x01)
  {
    HAL_Delay(1);
  }
}

static void W25_WriteEnable(void)
{
  uint8_t cmd = W25Q_WRITE_ENABLE;

  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi1, &cmd, 1, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_SET);
}

static void W25_EraseSector(uint32_t address)
{
  uint8_t cmd = W25Q_SECTOR_ERASE;
  uint8_t addr[3];

  addr[0] = (address >> 16) & 0xFF;
  addr[1] = (address >> 8) & 0xFF;
  addr[2] = address & 0xFF;

  W25_WriteEnable();

  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi1, &cmd, 1, HAL_MAX_DELAY);
  HAL_SPI_Transmit(&hspi1, addr, 3, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_SET);

  W25_WaitBusy();
}

static void W25_PageProgram(uint32_t address, const uint8_t *data, uint16_t size)
{
  uint8_t cmd = W25Q_PAGE_PROGRAM;
  uint8_t addr[3];

  addr[0] = (address >> 16) & 0xFF;
  addr[1] = (address >> 8) & 0xFF;
  addr[2] = address & 0xFF;

  W25_WriteEnable();

  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi1, &cmd, 1, HAL_MAX_DELAY);
  HAL_SPI_Transmit(&hspi1, addr, 3, HAL_MAX_DELAY);
  HAL_SPI_Transmit(&hspi1, (uint8_t *)data, size, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_SET);

  W25_WaitBusy();
}

static void W25_ReadData(uint32_t address, uint8_t *buffer, uint16_t size)
{
  uint8_t cmd = W25Q_READ_DATA;
  uint8_t addr[3];

  addr[0] = (address >> 16) & 0xFF;
  addr[1] = (address >> 8) & 0xFF;
  addr[2] = address & 0xFF;

  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi1, &cmd, 1, HAL_MAX_DELAY);
  HAL_SPI_Transmit(&hspi1, addr, 3, HAL_MAX_DELAY);
  HAL_SPI_Receive(&hspi1, buffer, size, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_SET);
}

static uint32_t W25_ReadJEDECID(void)
{
  uint8_t tx[4] = {W25Q_JEDEC_ID, 0xFF, 0xFF, 0xFF};
  uint8_t rx[4] = {0};

  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_RESET);
  HAL_SPI_TransmitReceive(&hspi1, tx, rx, 4, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(W25_CS_PORT, W25_CS_PIN, GPIO_PIN_SET);

  return ((uint32_t)rx[1] << 16) | ((uint32_t)rx[2] << 8) | rx[3];
}

static uint32_t W25_ReadWord(uint32_t address)
{
  uint32_t value = 0xFFFFFFFFU;
  W25_ReadData(address, (uint8_t *)&value, 4);
  return value;
}

static void W25_WriteWord(uint32_t address, uint32_t value)
{
  W25_PageProgram(address, (uint8_t *)&value, 4);
}

static int32_t Ultrasonic_ReadCm(void)
{
  uint32_t echo_start;
  uint32_t echo_end;
  uint32_t pulse_us;

  HAL_GPIO_WritePin(TRIG_PORT, TRIG_PIN, GPIO_PIN_RESET);
  delay_us(2);

  HAL_GPIO_WritePin(TRIG_PORT, TRIG_PIN, GPIO_PIN_SET);
  delay_us(10);
  HAL_GPIO_WritePin(TRIG_PORT, TRIG_PIN, GPIO_PIN_RESET);

  /* Wait for ECHO high */
  uint32_t start_ms = HAL_GetTick();
  while (HAL_GPIO_ReadPin(ECHO_PORT, ECHO_PIN) == GPIO_PIN_RESET)
  {
    if ((HAL_GetTick() - start_ms) > 50U)
      return -1;
  }

  echo_start = DWT->CYCCNT;

  /* Wait for ECHO low */
  while (HAL_GPIO_ReadPin(ECHO_PORT, ECHO_PIN) == GPIO_PIN_SET)
  {
    if (((DWT->CYCCNT - echo_start) / dwt_cycles_per_us) > 30000U)
      return -1;
  }

  echo_end = DWT->CYCCNT;
  pulse_us = (echo_end - echo_start) / dwt_cycles_per_us;

  return (int32_t)(pulse_us / 58U);
}

static void PrintSavedHistory(void)
{
  char msg[80];

  UART_Print("\r\n--- Saved readings in external flash ---\r\n");
  for (uint32_t i = 0; i < HISTORY_COUNT; i++)
  {
    uint32_t value = W25_ReadWord(FLASH_BASE_ADDR + (i * 4U));
    if (value != 0xFFFFFFFFU)
    {
      snprintf(msg, sizeof(msg), "Slot %lu = %lu cm\r\n",
               (unsigned long)i,
               (unsigned long)value);
      UART_Print(msg);
    }
  }
}
